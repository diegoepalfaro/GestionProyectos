@model IEnumerable<GestionTareas.Models.Proyecto>

@{
    ViewBag.Title = "Seleccionar proyecto";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Seleccionar proyecto</title>

    <style>
        /* =====================================================
                   TUS ESTILOS ORIGINALES (NO SE MODIFICÓ NADA)
                   ===================================================== */

        body {
            font-family: Arial, sans-serif;
            background-color: #e6e6e6;
            margin: 0;
            padding: 30px;
        }

        h2 {
            margin-bottom: 20px;
        }

        .tabla-proyectos {
            width: 70%;
            background-color: #fff;
            border-radius: 6px;
            border-collapse: collapse;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }

            .tabla-proyectos th,
            .tabla-proyectos td {
                padding: 12px 15px;
                border-bottom: 1px solid #ddd;
            }

            .tabla-proyectos tr:last-child td {
                border-bottom: none;
            }

        .btn-ver {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 4px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            font-size: 14px;
        }

            .btn-ver:hover {
                background-color: #005bbd;
            }




        /* =====================================================
                   🚀 ESTILO PROFESIONAL AGREGADO (MÁS ELEGANTE)
                   ===================================================== */

        :root {
            --azul: #3A87AD;
            --gris-fondo: #F5F5F5;
            --gris-borde: #E0E0E0;
            --blanco: #FFFFFF;
            --texto: #333333;
        }

        body {
            background-color: var(--gris-fondo) !important;
            font-family: 'Segoe UI', Arial, sans-serif !important;
        }

        h2 {
            font-size: 26px !important;
            font-weight: 700 !important;
            color: var(--texto) !important;
            margin-bottom: 25px !important;
        }

        /* Tabla estilo tarjeta */
        .tabla-proyectos {
            width: 75% !important;
            border-radius: 12px !important;
            box-shadow: 0 4px 14px rgba(0,0,0,0.12) !important;
            overflow: hidden;
            background: var(--blanco) !important;
        }

            .tabla-proyectos th {
                background: var(--azul) !important;
                color: white !important;
                font-size: 16px;
                font-weight: 600;
                padding: 14px !important;
                text-align: left;
            }

            .tabla-proyectos td {
                font-size: 15px !important;
                border-bottom: 1px solid var(--gris-borde) !important;
                padding: 16px 18px !important;
            }

            .tabla-proyectos tr:hover {
                background-color: #f0f7fb !important;
                transition: .25s ease-in-out;
            }

        .btn-ver {
            background: var(--azul) !important;
            font-weight: 600 !important;
            padding: 8px 12px !important;
            border-radius: 6px !important;
        }

            .btn-ver:hover {
                background: #2f6f8c !important;
            }

    </style>
</head>

<body>
    <h2>Selecciona un proyecto para ver sus tareas</h2>

    @if (Model != null && Model.Any())
    {
        <table class="tabla-proyectos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Fecha inicio</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Nombre</td>
                        <td>@p.FechaInicio.ToString("yyyy-MM-dd")</td>
                        <td>@p.Estado</td>
                        <td>
                            @Html.ActionLink(
                            "Ver tareas",
                                        "Proyecto",
                                        "Tareas",
                                        new { id = p.ProyectoID },
                                        new { @class = "btn-ver" }
                                        )
                </td>
            </tr>
                        }
            </tbody>
        </table>
    }
    else
    {
        <p>No tienes proyectos asignados aún.</p>
    }
</body>
</html>
