@model IEnumerable<GestionTareas.Models.Proyecto>

@{
    ViewBag.Title = "Seleccionar proyecto";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Seleccionar proyecto</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #e6e6e6; margin: 0; padding: 30px; }
        h2 { margin-bottom: 20px; }
        .tabla-proyectos {
            width: 70%;
            background-color: #fff;
            border-radius: 6px;
            border-collapse: collapse;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }
        .tabla-proyectos th, .tabla-proyectos td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
        }
        .tabla-proyectos tr:last-child td {
            border-bottom: none;
        }
        .btn-ver {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 4px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            font-size: 14px;
        }
        .btn-ver:hover {
            background-color: #005bbd;
        }
    </style>
</head>
<body>
    <h2>Selecciona un proyecto para ver sus tareas</h2>

    @if (Model != null && Model.Any())
    {
        <table class="tabla-proyectos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Fecha inicio</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Nombre</td>
                        <td>@p.FechaInicio.ToString("yyyy-MM-dd")</td>
                        <td>@p.Estado</td>
                        <td>
                            @Html.ActionLink(
                                     "Ver tareas",
                                     "Proyecto",
                                     "Tareas",
                                     new { id = p.ProyectoID },
                                     new { @class = "btn-ver" }
                                     )
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No tienes proyectos asignados aún.</p>
    }
</body>
</html>
