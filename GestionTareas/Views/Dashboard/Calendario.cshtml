@{
    ViewData["Title"] = "Calendario";
}

<h2>Calendario de Proyectos y Tareas</h2>

<!-- Estilos y scripts de FullCalendar 6 -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<div id="calendar" style="max-width: 1000px; margin: 20px auto;"></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'es',
            height: 'auto',

            // 🔥 Aquí carga tus PROYECTOS + TAREAS desde el controlador:
            events: '/Dashboard/GetProyectosAsEvents',

            eventClick: function (info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                }
                info.jsEvent.preventDefault();
            }
        });

        calendar.render();
    });
</script>

<style>
    #calendar {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
</style>
