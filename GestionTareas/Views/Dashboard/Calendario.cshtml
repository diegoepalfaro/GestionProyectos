@{
    ViewData["Title"] = "Calendario";
}

<h2 style="color:#3A87AD; font-weight:700; margin-bottom:15px;">
    Calendario de Proyectos y Tareas
</h2>

<!-- FullCalendar v6 (bundle global) -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<div id="calendar"></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var calendarEl = document.getElementById('calendar');

        console.log("URL de eventos:", '@Url.Action("GetProyectosAsEvents", "Dashboard")');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'es',
            height: 'auto',

            // 👇 Aquí se cargan los eventos desde tu acción del controlador
            events: '@Url.Action("GetProyectosAsEvents", "Dashboard")',

            eventClick: function (info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                }
                info.jsEvent.preventDefault();
            }
        });

        calendar.render();
    });
</script>

<style>
    :root {
        --azul: #3A87AD;
        --gris-fondo: #F5F5F5;
        --gris-borde: #E0E0E0;
        --texto: #333;
        --blanco: #FFFFFF;
    }

    body {
        font-family: 'Segoe UI', Arial, sans-serif !important;
        background-color: var(--gris-fondo) !important;
    }

    #calendar {
        background: #FFFFFF;
        padding: 25px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        max-width: 1100px;
        margin: 25px auto;
        border: 1px solid #E0E0E0;
    }

    .fc-daygrid-day-number {
        font-weight: 600;
        color: #333;
    }

    .fc-event:hover {
        opacity: .85;
        cursor: pointer;
        transform: scale(1.02);
        transition: .15s ease;
    }

    .fc-button {
        background: var(--azul) !important;
        border: none !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        letter-spacing: 0.3px;
    }

        .fc-button:hover {
            background: #2f6f8c !important;
        }

    .fc-toolbar-title {
        color: var(--azul) !important;
        font-weight: 700 !important;
        font-size: 1.7rem !important;
    }

    .fc-daygrid-day {
        background: var(--gris-fondo) !important;
        transition: background .15s ease;
    }

        .fc-daygrid-day:hover {
            background: #e9f3f9 !important;
        }

    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #E4E4E4 !important;
    }

    .fc-event {
        border-radius: 8px !important;
        padding: 5px 7px !important;
        font-size: 14px !important;
    }

        .fc-event:hover {
            transform: scale(1.05);
            opacity: 0.9;
        }
</style>
