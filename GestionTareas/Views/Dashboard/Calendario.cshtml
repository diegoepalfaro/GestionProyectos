@{
    ViewData["Title"] = "Calendario";
}

<h2 style="color:#3A87AD; font-weight:700; margin-bottom:15px;">
    Calendario de Proyectos y Tareas
</h2>

<!-- FullCalendar -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<div id="calendar"></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'es',
            height: 'auto',

            events: '/Dashboard/GetProyectosAsEvents',

            eventClick: function (info) {
                if (info.event.url) {
                    window.location.href = info.event.url;
                }
                info.jsEvent.preventDefault();
            }
        });

        calendar.render();
    });
</script>

<style>
    /* Fondo general del contenedor */
    #calendar {
        background: #FFFFFF;
        padding: 25px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        max-width: 1100px;
        margin: 25px auto;
        border: 1px solid #E0E0E0;
    }

    /* Estilos del FullCalendar */
    .fc-daygrid-day-number {
        font-weight: 600;
        color: #333;
    }

    /* Hover en eventos */
    .fc-event:hover {
        opacity: .85;
        cursor: pointer;
        transform: scale(1.02);
        transition: .15s ease;
    }

    /* Botones superiores del calendario */
    .fc-button {
        background: #3A87AD !important;
        border: none !important;
        border-radius: 6px !important;
        padding: 6px 12px !important;
        font-size: 14px !important;
    }

        .fc-button:hover {
            background: #356f8c !important;
        }

    /* Título del mes */
    .fc-toolbar-title {
        color: #3A87AD;
        font-weight: 700;
        font-size: 1.4rem;
    }

    /* Fondo de los días */
    .fc-daygrid-day {
        background: #F5F5F5;
    }

    /* Borde de celdas */
    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #dcdcdc;
    }
</style>
