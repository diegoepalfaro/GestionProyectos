@model GestionTareas.Models.Usuario

@{
    ViewData["Title"] = "Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .registro-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 40px;
        width: 100%;
    }

    .registro-card {
        width: 650px;
        background: #ffffff;
        padding: 35px 40px;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        font-family: Arial, sans-serif;
    }

    .registro-card h2 {
        text-align: center;
        margin-bottom: 30px;
        font-size: 28px;
        font-weight: 600;
    }

    .row-flex {
        display: flex;
        gap: 20px;
        margin-bottom: 18px;
    }

    .form-group-custom {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .form-group-custom label {
            font-weight: bold;
            margin-bottom: 6px;
        }

        .form-group-custom input {
            padding: 11px;
            border: 1px solid #b5b5b5;
            border-radius: 5px;
            font-size: 15px;
        }

    .btn-registrar {
        width: 100%;
        margin-top: 20px;
        background: #007bff;
        color: white;
        border: none;
        padding: 13px;
        font-size: 18px;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn-registrar:hover {
            background: #026bda;
        }

    .mensaje-error {
        margin-top: 12px;
        color: red;
        text-align: center;
    }
</style>

<div class="registro-wrapper">
    <div class="registro-card">
        <h2>Registro de Usuario</h2>

        @using (Html.BeginForm("Create", "Usuarios", FormMethod.Post))
        {
            @Html.ValidationSummary(true, "", new { @class = "mensaje-error" })

            <div class="row-flex">
                <div class="form-group-custom">
                    <label>Nombre</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @placeholder = "Nombre", @class = "form-control" })
                </div>

                <div class="form-group-custom">
                    <label>Apellido</label>
                    @Html.TextBox("Apellido", null, new { @placeholder = "Apellido", @class = "form-control" })
                </div>
            </div>

            <div class="row-flex">
                <div class="form-group-custom">
                    <label>Correo</label>
                    @Html.TextBoxFor(m => m.Email, new { @type = "email", @placeholder = "correo@correo.com", @class = "form-control" })
                </div>
            </div>

            <div class="row-flex">
                <div class="form-group-custom">
                    <label>Contraseña</label>
                    <input type="password" name="Password" placeholder="Contraseña" class="form-control" required />
                </div>

                <div class="form-group-custom">
                    <label>Confirmar contraseña</label>
                    <input type="password" name="ConfirmPassword" placeholder="Confirmar contraseña" class="form-control" required />
                </div>
            </div>

            <button type="submit" class="btn-registrar">Registrarse</button>
        }
    </div>
</div>
