@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* * El 'login-container' se ajusta a la altura total de la pantalla 
     * para que el formulario siempre esté centrado verticalmente.
     */
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 100px); /* Ajusta si tu header/footer tiene otra altura */
        background-color: #f0f2f5; /* Un fondo gris claro */
    }

    /* * CAMBIO CLAVE: Eliminamos el 'max-width' y ajustamos el padding y el margen.
     * Ahora, la tarjeta ocupará el 100% del espacio horizontal disponible.
     */
    .login-card {
        background-color: #fff;
        padding: 40px;
        border-radius: 0; /* Opcional: Elimina el borde redondeado para ajustarse a los bordes */
        box-shadow: none; /* Opcional: Elimina la sombra */
        width: 100%; 
        max-width: 100%; /* Asegura que ocupe todo el ancho */
        height: auto;
        text-align: center;
    }

    /* Estilos para el placeholder del avatar (sin cambios) */
    .avatar-placeholder {
        width: 100px;
        height: 100px;
        background-color: #e0e0e0;
        border-radius: 50%;
        margin: 0 auto 30px auto;
    }

    /* Estilo para el botón primario (se ajusta al 100% de la tarjeta) */
    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        width: 100%;
        padding: 10px;
        font-size: 16px;
        margin-top: 20px;
    }

    /* Estilo para los campos de formulario y etiquetas (sin cambios) */
    .form-group label {
        display: block;
        text-align: left;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .form-control {
        border-radius: 5px;
        padding: 10px 15px;
        font-size: 16px;
        height: auto;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .login-card h2 {
        font-size: 24px;
        color: #333;
        margin-bottom: 30px;
    }

    .register-link {
        display: block;
        margin-top: 25px;
        color: #007bff;
        text-decoration: none;
        font-weight: 500;
    }
    .register-link:hover {
        text-decoration: underline;
    }
    
    .alert-danger {
        text-align: left;
        font-size: 14px;
    }

</style>

<div class="login-container">
    <div class="login-card">
        <div class="avatar-placeholder"></div> 
        
        <h2>Ingresar</h2>

        @using (Html.BeginForm("Login", "Usuarios", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label for="email">Correo:</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="nombre@ejemplo.com" required  />
            </div>

            <div class="form-group">
                <label for="password">Contraseña:</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Contraseña" required />
            </div>

            <button type="submit" class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Ingresar</button>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
        {
            <div class="alert alert-danger mt-3" role="alert">
                @foreach (var error in ViewData.ModelState[""].Errors)
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <p class="register-link">¿No tienes cuenta? @Html.ActionLink("Regístrate aquí", "Create", "Usuarios")</p>
    </div>
</div>