@model IEnumerable<GestionTareas.Models.Equipo>
@{
    ViewBag.Title = "Mis Equipos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    /* =====================================
           🎨 PALETA Y BASE DEL PROTOTIPO
           ===================================== */
    :root {
        --azul: #3A87AD;
        --azul-hover: #2f6f8c;
        --gris-fondo: #F5F5F5;
        --gris-borde: #E0E0E0;
        --blanco: #FFFFFF;
        --texto: #333;
    }

    body {
        font-family: 'Segoe UI', Arial, sans-serif !important;
        background-color: var(--gris-fondo) !important;
    }

    /* =====================================
           🏷️ Título + botón crear
           ===================================== */
    .titulo-equipos {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .titulo-equipos h2 {
            font-size: 28px;
            font-weight: 700;
            color: var(--texto);
            margin: 0;
        }

    .btn-crear-equipo {
        background-color: var(--azul);
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        transition: .2s ease;
    }

        .btn-crear-equipo:hover {
            background-color: var(--azul-hover);
        }

    /* =====================================
           📄 Tabla estilizada
           ===================================== */
    .tabla-equipos {
        width: 100%;
        background: var(--blanco);
        border-radius: 12px;
        border-collapse: collapse;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }

        .tabla-equipos th {
            background: var(--azul);
            color: white;
            font-weight: 600;
            font-size: 16px;
            padding: 16px 18px;
            border-bottom: 1px solid var(--gris-borde);
        }

        .tabla-equipos td {
            padding: 15px 18px;
            border-bottom: 1px solid var(--gris-borde);
            font-size: 15px;
            color: var(--texto);
        }

        .tabla-equipos tr:last-child td {
            border-bottom: none;
        }

        .tabla-equipos tbody tr:hover {
            background-color: #e9f3f9;
            transition: .25s ease-in-out;
        }

    /* =====================================
           🔗 Enlaces de acción
           ===================================== */
    .accion-enlace {
        text-decoration: none;
        color: var(--azul);
        font-weight: 600;
        font-size: 15px;
    }

        .accion-enlace:hover {
            color: var(--azul-hover);
            text-decoration: underline;
        }

</style>

<div class="titulo-equipos">
    <h2>Mis Equipos</h2>
    <a href="@Url.Action("Create", "Equipos")" class="btn-crear-equipo">+ Crear equipo</a>
</div>

@if (!Model.Any())
{
    <p>No estás en ningún equipo todavía.</p>
}
else
{
    <table class="tabla-equipos">
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acción</th>
        </tr>

        @foreach (var equipo in Model)
        {
            <tr>
                <td>@equipo.Nombre</td>
                <td>@equipo.Descripcion</td>
                <td>
                    <a href="@Url.Action("AgregarMiembros", "Equipos", new { id = equipo.EquipoID })" class="accion-enlace">
                        Administrar equipo
                    </a>
                </td>
            </tr>
        }
    </table>
}
