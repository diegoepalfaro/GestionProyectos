@model List<GestionTareas.Models.Tarea>

@{
    Layout = null;
    bool esLider = ViewBag.EsLider == true;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Tareas – @ViewBag.ProyectoNombre</title>

    <style>

        /* ===========================================================================
                   🎨 PALETA GLOBAL
                ============================================================================ */
        :root {
            --azul: #3A87AD;
            --azul-hover: #2f6f8c;
            --gris-fondo: #F5F5F5;
            --gris-card: #FFFFFF;
            --gris-borde: #E0E0E0;
            --texto: #333;
            --sombra: 0 4px 14px rgba(0,0,0,0.12);
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif !important;
            margin: 0;
            padding: 0;
            background: var(--gris-fondo);
        }

        /* ===========================================================================
                   📌 HEADER
                ============================================================================ */
        .header {
            background: var(--azul);
            color: white;
            padding: 18px 25px;
            font-size: 22px;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--sombra);
        }

            .header a {
                color: white;
                text-decoration: underline;
                font-size: 15px;
                font-weight: 500;
            }

                .header a:hover {
                    opacity: .85;
                }

        /* ===========================================================================
                   ➕ BOTÓN NUEVA TAREA
                ============================================================================ */
        .btn-crear {
            margin: 20px;
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            background: var(--azul);
            color: white;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            box-shadow: var(--sombra);
        }

            .btn-crear:hover {
                background: var(--azul-hover);
            }

        /* ===========================================================================
                   📦 LAYOUT PRINCIPAL
                ============================================================================ */
        .contenedor {
            display: flex;
            gap: 30px;
            padding: 30px;
        }

        .columna {
            width: 33%;
            background: var(--gris-card);
            padding: 18px;
            border-radius: 14px;
            box-shadow: var(--sombra);
            border: 1px solid var(--gris-borde);
        }

            .columna h2 {
                text-align: center;
                margin-bottom: 20px;
                font-size: 20px;
                color: var(--texto);
                font-weight: 700;
            }

        /* ===========================================================================
                   🧩 TAREAS (CARDS)
                ============================================================================ */
        .tarea {
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 14px;
            box-shadow: var(--sombra);
            border: 1px solid var(--gris-borde);
            transition: .25s ease;
        }

            .tarea:hover {
                transform: scale(1.02);
            }

            /* Colores por prioridad */
            .tarea.alta {
                background-color: #ffb3e6;
            }

            .tarea.media {
                background-color: #fff3a3;
            }

            .tarea.baja {
                background-color: #cce7ff;
            }

        .prioridad {
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 6px;
            color: #444;
        }

        /* ===========================================================================
                   🔘 BOTONES DE CAMBIAR ESTADO
                ============================================================================ */
        .botones button {
            margin-top: 8px;
            width: 100%;
            padding: 8px;
            border: none;
            cursor: pointer;
            border-radius: 6px;
            background: var(--azul);
            color: white;
            font-weight: 600;
            box-shadow: var(--sombra);
        }

            .botones button:hover {
                background: var(--azul-hover);
            }

        /* ===========================================================================
                   💬 COMENTARIOS LINK
                ============================================================================ */
        .link-comentarios {
            display: inline-block;
            margin-top: 6px;
            font-size: 14px;
            color: var(--azul);
            text-decoration: underline;
            font-weight: 500;
        }

            .link-comentarios:hover {
                color: var(--azul-hover);
            }

        /* ===========================================================================
                   🪟 MODAL CREAR TAREA
                ============================================================================ */
        #crear {
            display: none;
            background: white;
            position: fixed;
            top: 18%;
            left: 35%;
            width: 32%;
            border: 1px solid var(--gris-borde);
            border-radius: 14px;
            box-shadow: 0 6px 22px rgba(0,0,0,0.45);
            animation: fadeIn .25s ease;
        }

        

        

        .modal-container {
            padding: 25px;
        }

        input, textarea, select {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid var(--gris-borde);
            margin-top: 4px;
            margin-bottom: 12px;
            font-family: inherit;
        }

            input:focus,
            textarea:focus,
            select:focus {
                border-color: var(--azul);
                outline: none;
                box-shadow: 0 0 4px rgba(58, 135, 173, 0.4);
            }

        #crear button {
            padding: 10px 16px;
            border-radius: 8px;
            background: var(--azul);
            border: none;
            color: white;
            cursor: pointer;
            font-weight: 600;
        }

            #crear button:hover {
                background: var(--azul-hover);
            }

    </style>
</head>

<body>

    <div class="header">
        Proyecto → @ViewBag.ProyectoNombre
        <a href="/Dashboard/Index">Volver al Dashboard</a>
    </div>

    @if (esLider)
    {
        <button onclick="document.getElementById('crear').style.display='block'" class="btn-crear">
            + Nueva tarea
        </button>
    }

    <div class="contenedor">
        <!-- --------------------- PENDIENTE --------------------- -->
        <div class="columna">
            <h2>Pendiente</h2>

            @foreach (var t in Model.Where(x => x.Estado == "Pendiente"))
            {
                <div class="tarea @(t.Prioridad == "Alta" ? "alta" : (t.Prioridad == "Media" ? "media" : "baja"))"
                     data-id="@t.TareaID" draggable="true">

                    <div class="prioridad">@t.Prioridad</div>
                    <b>@t.Titulo</b><br />
                    @t.Descripcion<br />

                    <a class="link-comentarios"
                       href="@Url.Action("Comentarios", "Tareas", new { tareaId = t.TareaID })">
                        💬 Ver comentarios
                    </a>

                    @if (esLider)
                    {
                        <div class="botones">
                            <a href="/Tareas/CambiarEstado?tareaId=@t.TareaID&nuevoEstado=En Progreso">
                                <button>→ En Progreso</button>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- --------------------- EN PROGRESO --------------------- -->
        <div class="columna">
            <h2>En Progreso</h2>

            @foreach (var t in Model.Where(x => x.Estado == "En Progreso"))
            {
                <div class="tarea @(t.Prioridad == "Alta" ? "alta" : (t.Prioridad == "Media" ? "media" : "baja"))"
                     data-id="@t.TareaID" draggable="true">

                    <div class="prioridad">@t.Prioridad</div>
                    <b>@t.Titulo</b><br />
                    @t.Descripcion<br />

                    <a class="link-comentarios"
                       href="@Url.Action("Comentarios", "Tareas", new { tareaId = t.TareaID })">
                        💬 Ver comentarios
                    </a>

                    @if (esLider)
                    {
                        <div class="botones">
                            <a href="/Tareas/CambiarEstado?tareaId=@t.TareaID&nuevoEstado=Completado">
                                <button>✔ Completar</button>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- --------------------- COMPLETADO --------------------- -->
        <div class="columna">
            <h2>Completado</h2>

            @foreach (var t in Model.Where(x => x.Estado == "Completado"))
            {
                <div class="tarea @(t.Prioridad == "Alta" ? "alta" : (t.Prioridad == "Media" ? "media" : "baja"))"
                     data-id="@t.TareaID" draggable="true">

                    <div class="prioridad">@t.Prioridad</div>
                    <b>@t.Titulo</b><br />
                    @t.Descripcion<br />

                    <a class="link-comentarios"
                       href="@Url.Action("Comentarios", "Tareas", new { tareaId = t.TareaID })">
                        💬 Ver comentarios
                    </a>

                    @if (esLider)
                    {
                        <form method="post" action="/Tareas/ActualizarFechaFin">
                            <input type="hidden" name="TareaID" value="@t.TareaID" />
                            <label style="font-size:12px;">Fecha fin:</label>
                            <input type="date" name="FechaFin"
                                   value="@t.FechaFin?.ToString("yyyy-MM-dd")" />
                            <button style="margin-top:4px; font-size:13px;">✔ Guardar fecha</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ====================== MODAL CREAR TAREA ====================== -->
    <div id="crear">
        <div class="modal-container">
            <form method="post" action="/Tareas/Crear">
                <input type="hidden" name="ProyectoID" value="@ViewBag.ProyectoID" />

                <label>Título</label>
                <input name="Titulo" required />

                <label>Descripción</label>
                <textarea name="Descripcion"></textarea>

                <label>Prioridad</label>
                <select name="Prioridad">
                    <option>Alta</option>
                    <option>Media</option>
                    <option>Baja</option>
                </select>

                <label>Fecha de fin</label>
                <input type="date" name="FechaFin" />

                <label>Asignar a usuario</label>
                <select name="AsignadoA">
                    <option value="">— Sin asignar —</option>
                    @foreach (var u in ViewBag.UsuariosEquipo)
                    {
                        <option value="@u.UsuarioID">@u.Nombre (@u.Email)</option>
                    }
                </select>

                <button type="submit">Guardar</button>
            </form>

            <button onclick="document.getElementById('crear').style.display='none'"
                    style="margin-top:10px; background:#555; width:100%;">
                Cancelar
            </button>
        </div>
    </div>


    <!-- =============================== JS DRAG & DROP =============================== -->
    <script>
        document.querySelectorAll('.columna').forEach(col => {
            col.ondragover = e => e.preventDefault();
            col.ondrop = e => {
                const tareaId = e.dataTransfer.getData("text");
                const nuevoEstado = col.querySelector("h2").innerText;

                fetch(`/Tareas/CambiarEstadoAjax?tareaId=${tareaId}&nuevoEstado=${encodeURIComponent(nuevoEstado)}`, {
                    method: "POST"
                }).then(() => location.reload());
            };
        });

        document.querySelectorAll('.tarea').forEach(t => {
            t.draggable = true;
            t.ondragstart = e => e.dataTransfer.setData("text", t.getAttribute("data-id"));
        });
    </script>

</body>
</html>
