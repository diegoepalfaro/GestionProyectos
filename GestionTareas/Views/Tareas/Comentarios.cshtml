@model GestionTareas.Models.Tarea

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Comentarios – @Model.Titulo</title>

    <style>

        /* ==========================================
                   🎨 PALETA PRINCIPAL DEL PROTOTIPO
                   ========================================== */
        :root {
            --azul: #3A87AD;
            --azul-hover: #2f6f8c;
            --gris-fondo: #F5F5F5;
            --gris-borde: #E0E0E0;
            --blanco: #FFFFFF;
            --texto: #333;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif !important;
            background: var(--gris-fondo);
            margin: 0;
            padding: 25px;
        }

        /* ==========================================
                   📌 Tarjeta principal
                   ========================================== */
        .card {
            background: var(--blanco);
            max-width: 850px;
            margin: 0 auto;
            padding: 30px;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.12);
            border: 1px solid var(--gris-borde);
        }

        h2 {
            margin-top: 0;
            font-size: 26px;
            font-weight: 700;
            color: var(--texto);
            margin-bottom: 12px;
        }

        h3 {
            margin-top: 25px;
            font-size: 20px;
            color: var(--texto);
            margin-bottom: 10px;
        }

        /* ==========================================
                   🗨️ Comentarios
                   ========================================== */
        .comentario {
            background: #e9f3f9;
            padding: 15px;
            margin: 10px 0;
            border-radius: 10px;
            border: 1px solid var(--gris-borde);
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

            .comentario b {
                color: var(--azul);
            }

        textarea {
            width: 100%;
            height: 140px;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid var(--gris-borde);
            font-size: 15px;
            resize: vertical;
            font-family: inherit;
            margin-bottom: 8px;
        }

            textarea:focus {
                outline: none;
                border-color: var(--azul);
                box-shadow: 0 0 4px rgba(58, 135, 173, 0.4);
            }

        /* ==========================================
                   🟦 Botón enviar
                   ========================================== */
        button {
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            background: var(--azul);
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s ease;
        }

            button:hover {
                background: var(--azul-hover);
            }

        /* ==========================================
                   🔙 Volver
                   ========================================== */
        a.volver {
            display: inline-block;
            margin-top: 20px;
            text-decoration: none;
            color: var(--azul);
            font-weight: 600;
        }

            a.volver:hover {
                color: var(--azul-hover);
                text-decoration: underline;
            }

    </style>
</head>

<body>
    <div class="card">

        <h2>Comentarios de la tarea: @Model.Titulo</h2>
        <p><b>Proyecto:</b> @Model.Proyecto.Nombre</p>

        <h3>Historial</h3>

        @if (Model.Comentarios != null && Model.Comentarios.Any())
        {
            @foreach (var c in Model.Comentarios.OrderByDescending(x => x.FechaComentario))
            {
                <div class="comentario">
                    <b>@c.Usuario.Nombre</b> (@c.FechaComentario)<br />
                    @c.TextoComentario
                </div>
            }
        }
        else
        {
            <p>No hay comentarios aún.</p>
        }

        <h3>Agregar comentario</h3>

        <form method="post" action="/Tareas/AgregarComentario">
            <input type="hidden" name="TareaID" value="@Model.TareaID" />
            <textarea name="Texto" required></textarea>
            <button type="submit">Enviar comentario</button>
        </form>

        <a class="volver" href="@Url.Action("Proyecto", "Tareas", new { id = Model.ProyectoID })">
            ← Volver al tablero de tareas
        </a>

    </div>
</body>
</html>
