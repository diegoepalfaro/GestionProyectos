@model GestionTareas.Models.Tarea

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Comentarios – @Model.Titulo</title>
    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            margin: 0;
            padding: 20px;
        }

        .card {
            background: white;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }

        h2 {
            margin-top: 0;
        }

        .comentario {
            background: #eee;
            padding: 10px;
            margin: 8px 0;
            border-radius: 5px;
        }

        textarea {
            width: 100%;
            height: 120px;
        }

        button {
            margin-top: 10px;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            background: #007bff;
            color: white;
            cursor: pointer;
        }

        a.volver {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: #007bff;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Comentarios de la tarea: @Model.Titulo</h2>
        <p><b>Proyecto:</b> @Model.Proyecto.Nombre</p>

        <h3>Historial</h3>
        @if (Model.Comentarios != null && Model.Comentarios.Any())
        {
            @foreach (var c in Model.Comentarios.OrderByDescending(x => x.FechaComentario))
            {
                <div class="comentario">
                    <b>@c.Usuario.Nombre</b> (@c.FechaComentario)<br />
                    @c.TextoComentario
                </div>
            }
        }
        else
        {
            <p>No hay comentarios aún.</p>
        }

        <h3>Agregar comentario</h3>
        <form method="post" action="/Tareas/AgregarComentario">
            <input type="hidden" name="TareaID" value="@Model.TareaID" />
            <textarea name="Texto" required></textarea><br />
            <button type="submit">Enviar comentario</button>
        </form>

        <a class="volver" href="@Url.Action("Proyecto","Tareas", new { id = Model.ProyectoID })">
            ← Volver al tablero de tareas
        </a>
    </div>
</body>
</html>
