@{
    ViewBag.Title = "Proyectos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .proyectos-container {
        background-color: #e9e9e9;
        padding: 40px;
        border-radius: 8px;
    }

    .btn-nuevo-proyecto {
        background-color: #0d6efd;
        color: white;
        font-weight: bold;
        padding: 10px 18px;
        border-radius: 7px;
        text-decoration: none;
    }

        .btn-nuevo-proyecto:hover {
            background-color: #0b5ed7;
        }

    .buscador-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 25px 0 35px 0;
    }

    .icon-lupa {
        width: 48px;
        height: 48px;
    }

    .campo-buscar {
        flex: 1;
        padding: 12px 15px;
        border-radius: 6px;
        border: 1px solid #bcbcbc;
        font-size: 15px;
    }

    .btn-buscar {
        background-color: #4CAF50;
        color: white;
        font-weight: bold;
        padding: 12px 22px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn-buscar:hover {
            background-color: #449e47;
        }

    .tabla-proyectos {
        width: 100%;
        background: white;
        border-radius: 8px;
        border-collapse: collapse;
        overflow: hidden;
    }

        .tabla-proyectos th,
        .tabla-proyectos td {
            padding: 16px;
            border-bottom: 1px solid #e0e0e0;
        }

        .tabla-proyectos tr:last-child td {
            border-bottom: none;
        }

        .tabla-proyectos th {
            font-weight: bold;
            text-align: center;
            background-color: #f5f5f5;
        }
</style>


<div class="proyectos-container">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="fw-bold">Proyectos</h2>
        @Html.ActionLink("+ Nuevo Proyecto", "Create", null, new { @class = "btn-nuevo-proyecto" })
    </div>

    <!-- Buscador -->
    @using (Html.BeginForm("Index", "Proyectos", FormMethod.Get))
    {
        <div class="buscador-wrapper">
            <img src="https://cdn-icons-png.flaticon.com/512/954/954591.png" class="icon-lupa" />
            <input type="text"
                   name="search"
                   class="campo-buscar"
                   placeholder="Buscar proyectos..."
                   value="@Context.Request.Query["search"]" />
            <button type="submit" class="btn-buscar">Buscar proyectos...</button>
        </div>
    }

    <!-- Tabla -->
    <table class="tabla-proyectos">
        <thead>
            <tr>
                <th>Proyecto</th>
                <th>Estado</th>
                <th>Progreso</th>
                <th>Fechas</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td style="font-weight: bold; width: 35%;">
                        @p.Nombre <br />
                        @Html.ActionLink("(Ver detalles)", "Details", new { id = p.ProyectoId }, new { @class = "text-decoration-none small" })
                    </td>

                    <td style="text-align:center;">
                        @p.Estado
                    </td>

                    <td style="text-align:center;">
                        @{
                            var progreso = (p.GetType().GetProperty("Progreso") != null) ? p.Progreso : 0;
                        }
                        @progreso %
                    </td>

                    <td style="text-align:center;">
                        @(p.FechaInicio != null ? ((DateTime)p.FechaInicio).ToString("dd/MM") : "--")
                        –
                        @(p.FechaFin != null ? ((DateTime)p.FechaFin).ToString("dd/MM") : "--")
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
