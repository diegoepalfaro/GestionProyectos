@model IEnumerable<GestionTareas.Models.Proyecto>

<h2>Proyectos</h2>

<form method="get">
    <input type="text" name="search" class="form-control" placeholder="Buscar proyecto..." />
</form>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Fecha Inicio</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Nombre</td>
                <td>@p.FechaInicio.ToString("yyyy-MM-dd")</td>
                <td>@p.Estado</td>
                <td>
                    @Html.ActionLink("Detalles", "Details", new { id = p.ProyectoID })
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create")" class="btn btn-primary">Crear nuevo proyecto</a>
