@model GestionTareas.Models.Proyecto

@{
    ViewBag.Title = "Crear Proyecto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5 create-wrap">
    <div class="card shadow-lg border-0 create-card">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-folder-plus"></i> Crear Proyecto
            </h4>
        </div>

        <div class="card-body">

            @Html.ActionLink("← Volver", "Index", null, new { @class = "btn btn-link text-decoration-none mb-3" })

            @using (Html.BeginForm("Create", "Proyectos", FormMethod.Post)) // Especificar Acción y Controlador es buena práctica
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "Por favor corrige los siguientes errores:", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ingrese el nombre del proyecto" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3, placeholder = "Descripción del proyecto" })
                    @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.FechaInicio, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-4">
                        @Html.LabelFor(m => m.FechaFin, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FechaFin, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FechaFin, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary me-2 btn-outline-blue" })

                    <input type="submit" value="Guardar" class="btn btn-primary btn-primary-blue" />
                </div>
            }
        </div>
    </div>
</div>