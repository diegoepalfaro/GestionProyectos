@model GestionTareas.Models.Proyecto

<h2>Crear Proyecto</h2>

@using (Html.BeginForm("Create", "Proyectos", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Nombre</label>
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Descripción</label>
        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Fecha Inicio</label>
        @Html.TextBoxFor(m => m.FechaInicio, new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        <label>Fecha Fin</label>
        @Html.TextBoxFor(m => m.FechaFin, new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        <label>Estado</label>
        @Html.DropDownListFor(m => m.Estado, new List<SelectListItem>
        {
        new SelectListItem { Text = "Pendiente", Value = "Pendiente" },
        new SelectListItem { Text = "En Progreso", Value = "En Progreso", Selected = true },
        new SelectListItem { Text = "Completado", Value = "Completado" }
        }, new { @class = "form-control" })
    </div>


    <div class="form-group">
        <label>Equipo</label>
        @Html.DropDownListFor(m => m.EquipoID, (SelectList)ViewBag.Equipos,
                "Seleccione un equipo", new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success mt-3">Guardar</button>
}
